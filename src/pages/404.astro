---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import gurvan from '../assets/plushes/gurvan-searching.png';
import sith from '../assets/plushes/doudou-sith-searching.png';
---

<Layout title="Nicolas Marien - Page not found" noindex>
  <div class="lost">
    <div class="search" aria-hidden="true">
      <Image src={gurvan} alt="" height={120} densities={[1, 2]} class="flip" />
      <Image src={sith} alt="" height={120} densities={[1, 2]} />
    </div>
    <p class="code">404</p>
    <h1>Not all those who wander are lost.</h1>
    <p class="story">
      This page is, though. Gurvan Greencloak and Doudou Sith searched everywhere: this isn't
      the page you're looking for.
    </p>
    <p class="ways"><a href="/">Back home</a><a href="/posts">All writing</a></p>
  </div>
</Layout>

<style>
  .lost {
    text-align: center;
    padding: 1rem 0 2rem;
  }

  .search {
    display: flex;
    justify-content: center;
    align-items: flex-end;
  }

  .search :global(img) {
    height: 120px;
    width: auto;
  }

  /* Back to back: Gurvan looks left while Doudou Sith looks right. */
  .search :global(.flip) {
    transform: scaleX(-1);
  }

  .code {
    font-style: italic;
    color: var(--lamp);
    margin: 1.5rem 0 0.3rem;
  }

  h1 {
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.015em;
    margin: 0 0 0.8rem;
  }

  .story {
    color: var(--dim);
    max-width: 28em;
    margin: 0 auto 1.6rem;
    line-height: 1.7;
  }

  .ways {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    margin: 0;
  }

  .ways a {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--lamp);
    text-underline-offset: 4px;
  }

  @media (max-width: 560px) {
    h1 {
      font-size: 1.6rem;
    }

    .search :global(img) {
      height: 96px;
    }
  }
</style>
